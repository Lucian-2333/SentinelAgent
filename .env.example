# ═══════════════════════════════════════════════════════════════════════════════
#  SentinelAgent — Environment Configuration Template
#
#  Local development:
#    cp .env.example .env   # then fill in your real keys
#
#  Docker / production:
#    cp .env.example .env   # fill in keys, set DB_PATH (see below)
#    docker compose up -d
#
#  ⚠  NEVER commit the filled-in .env to version control.
#     It is already listed in .gitignore.
# ═══════════════════════════════════════════════════════════════════════════════


# ── Runtime mode ─────────────────────────────────────────────────────────────
# 1 = demo mode  (built-in scripted responses, no LLM calls, no API key needed)
# 0 = production (calls the real LLM specified by LLM_PROVIDER)
SENTINEL_DEMO_MODE=1


# ── LLM Provider ─────────────────────────────────────────────────────────────
# Supported: deepseek | openai | anthropic | openai_compatible
LLM_PROVIDER=deepseek


# ── DeepSeek ─────────────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=deepseek
# Get your key at: https://platform.deepseek.com/api_keys
# Replace the placeholder below with your real key before running deploy.sh
DEEPSEEK_API_KEY=sk-REPLACE_WITH_YOUR_REAL_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat


# ── OpenAI ───────────────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=openai (leave blank otherwise)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o


# ── Anthropic (Claude) ───────────────────────────────────────────────────────
# Required when LLM_PROVIDER=anthropic (leave blank otherwise)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5


# ── OpenAI-compatible endpoint ───────────────────────────────────────────────
# Use for Ollama, vLLM, ZhipuAI, Moonshot, SiliconFlow, local models, etc.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=


# ── LLM shared parameters ────────────────────────────────────────────────────
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1


# ── Verdict thresholds ───────────────────────────────────────────────────────
# aggregate_confidence >= BLOCK_THRESHOLD      → BLOCK
# aggregate_confidence >= QUARANTINE_THRESHOLD → QUARANTINE  (else ALLOW)
# Adjust without redeploying; defaults shown below.
BLOCK_THRESHOLD=0.70
QUARANTINE_THRESHOLD=0.45


# ── CORS (gateway API) ───────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the FastAPI gateway.
# In production, set this to the exact origin(s) of your frontend.
# Default (when unset): http://localhost:8501 only.
CORS_ALLOWED_ORIGINS=http://localhost:8501


# ── Gateway API Key ──────────────────────────────────────────────────────────
# Protects /api/v1/intercept and /api/v1/audit from unauthorized access.
# Callers must send:  Authorization: Bearer <key>
# Leave blank to disable authentication (open access — not recommended).
# Generate a key: python3 -c "import secrets; print(secrets.token_hex(32))"
SENTINEL_API_KEY=


# ── Admin Dashboard credentials ──────────────────────────────────────────────
# ⚠  CHANGE BOTH VALUES before going live — the defaults are intentionally weak.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOY


# ── Database path ────────────────────────────────────────────────────────────
# Docker deployment (recommended):
#   The docker-compose.yml volume mount maps ./data (host) → /app/data (container).
#   Set this to the in-container path so the DB survives container recreations.
DB_PATH=/app/data/sentinel_audit.db

# Local development alternative (uncomment and clear the line above):
# DB_PATH=
# (empty = falls back to sentinel_audit.db in the project root)
