# ═══════════════════════════════════════════════════════════════════
#  SentinelAgent — Environment Configuration Template
#  复制此文件为 .env，填入真实密钥后使用
#  cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ── 运行模式 ───────────────────────────────────────────────────────
# 1 = 演示模式（使用内置脚本响应，不调用任何 LLM，无需 key）
# 0 = 生产模式（调用真实 LLM API）
SENTINEL_DEMO_MODE=1

# ── LLM 提供商选择 ────────────────────────────────────────────────
# 可选值: deepseek | openai | anthropic | openai_compatible
LLM_PROVIDER=deepseek

# ── DeepSeek ──────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── Anthropic (Claude) ────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5

# ── 自定义 OpenAI 兼容端点 ────────────────────────────────────────
# 例如: Ollama / vLLM / 智谱 / 月之暗面 / 硅基流动 / 本地模型 等
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# ── LLM 通用参数 ─────────────────────────────────────────────────
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1

# ── Admin Dashboard 认证 ──────────────────────────────────────────
# 部署前请修改这两个值！
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ── 数据库路径 ────────────────────────────────────────────────────
# 留空 = 使用项目根目录下的 sentinel_audit.db（本地开发默认）
# 生产环境建议设为绝对路径，例如：
# DB_PATH=/opt/sentinel/data/sentinel_audit.db
DB_PATH=
